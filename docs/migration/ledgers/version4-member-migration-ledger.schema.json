{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nltx.local/schemas/version4-member-migration-ledger-1.0.json",
  "title": "Version4 to NLTX member migration ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "metadata",
    "baseline",
    "scope",
    "policies",
    "inventory",
    "decisions",
    "evidenceCatalog",
    "verificationCatalog",
    "workItems",
    "changeLog",
    "generatedViewMetadata"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "scope": { "$ref": "#/$defs/scope" },
    "policies": { "$ref": "#/$defs/policies" },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceMembers"],
      "properties": {
        "sourceMembers": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceMember" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "evidenceCatalog": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "verificationCatalog": {
      "type": "array",
      "items": { "$ref": "#/$defs/verification" }
    },
    "workItems": {
      "type": "array",
      "items": { "$ref": "#/$defs/workItem" }
    },
    "changeLog": {
      "type": "array",
      "items": { "$ref": "#/$defs/changeLogEntry" }
    },
    "generatedViewMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["views"],
      "properties": {
        "views": {
          "type": "array",
          "items": { "$ref": "#/$defs/generatedView" }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "ledgerId",
        "revision",
        "scopeRevision",
        "sourceSnapshotPath",
        "targetSnapshotPath"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "ledgerId": { "$ref": "#/$defs/nonEmpty" },
        "revision": { "type": "integer", "minimum": 1 },
        "scopeRevision": { "$ref": "#/$defs/sha256" },
        "sourceSnapshotPath": { "$ref": "#/$defs/nonEmpty" },
        "targetSnapshotPath": { "$ref": "#/$defs/nonEmpty" },
        "sourceSnapshotSha256": { "$ref": "#/$defs/sha256" },
        "targetSnapshotSha256": { "$ref": "#/$defs/sha256" },
        "ledgerFactSha256": { "$ref": "#/$defs/sha256" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRoot", "coverageFile", "sourceFileCount", "coverageSha256"],
      "properties": {
        "sourceRoot": { "const": "D:/TRbackup/Version4" },
        "coverageFile": { "$ref": "#/$defs/nonEmpty" },
        "sourceFileCount": { "type": "integer", "minimum": 1 },
        "coverageSha256": { "$ref": "#/$defs/sha256" },
        "referenceSupplementRoot": { "type": ["string", "null"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memberScope", "targetManifest", "targetManifestSha256"],
      "properties": {
        "memberScope": { "$ref": "#/$defs/memberScope" },
        "targetManifest": {
          "type": "array",
          "items": { "$ref": "#/$defs/targetMember" }
        },
        "targetManifestPath": { "type": ["string", "null"] },
        "targetManifestSha256": { "$ref": "#/$defs/sha256" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "memberScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceMemberIds", "sha256"],
      "properties": {
        "kind": { "const": "allowlist" },
        "sourceMemberIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalRemoval", "sourceIdentity", "targetIdentity", "oneActiveWorkItem"],
      "properties": {
        "physicalRemoval": { "const": "forbidden" },
        "sourceIdentity": { "const": "Version4::<fully-qualified-declaring-type>::<member-signature>" },
        "targetIdentity": { "const": "<target-root>::<project-or-assembly>::<fully-qualified-type>::<member-signature>" },
        "oneActiveWorkItem": { "const": true },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "sourceMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMemberId",
        "path",
        "declaringType",
        "member",
        "signature",
        "kind",
        "type",
        "accessibility",
        "modifiers",
        "locations",
        "sourceFingerprint"
      ],
      "properties": {
        "sourceMemberId": { "pattern": "^Version4::[^:/\\\\]+::[^:/\\\\]+$" },
        "path": { "$ref": "#/$defs/nonEmpty" },
        "declaringType": { "$ref": "#/$defs/nonEmpty" },
        "member": { "$ref": "#/$defs/nonEmpty" },
        "signature": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["field", "property"] },
        "type": { "$ref": "#/$defs/nonEmpty" },
        "accessibility": { "enum": ["public", "private", "protected", "internal", "protected-internal", "private-protected", "none"] },
        "modifiers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/location" }
        },
        "sourceFingerprint": { "$ref": "#/$defs/sha256" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateKind", "scope", "lifecycle", "authority", "persistence", "network"],
      "properties": {
        "fileOwner": { "$ref": "#/$defs/nonEmpty" },
        "stateKind": { "enum": ["authoritative", "derived", "compatibility", "configuration", "cache", "identity", "event", "unknown"] },
        "scope": { "enum": ["entity", "world", "session", "global", "request", "value", "unknown"] },
        "lifecycle": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "authority": { "$ref": "#/$defs/nonEmpty" },
        "persistence": { "enum": ["required", "not-applicable", "unknown"] },
        "network": { "enum": ["required", "not-applicable", "unknown"] },
        "accessRisks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["reflection", "serialization", "generated-code", "dynamic", "delegate", "native-adapter", "helper-indirect"] }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMemberId",
        "sourceFingerprint",
        "classification",
        "disposition",
        "status",
        "targetMappings",
        "evidenceRefs",
        "verificationRefs",
        "readerWriterStatus",
        "verificationStatus",
        "batchId",
        "priority",
        "nextWorkItemRef",
        "blocker"
      ],
      "properties": {
        "sourceMemberId": { "$ref": "#/$defs/nonEmpty" },
        "sourceFingerprint": { "$ref": "#/$defs/sha256" },
        "classification": { "$ref": "#/$defs/classification" },
        "disposition": { "enum": ["move", "split", "merge", "derive", "compatibility", "excluded", "deferred"] },
        "status": { "enum": ["todo", "in-progress", "migrated", "verified", "blocked", "deferred"] },
        "targetMappings": { "type": "array", "items": { "$ref": "#/$defs/mapping" } },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "verificationRefs": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "readerWriterStatus": { "enum": ["closed", "open", "partial", "unknown", "scan-failed"] },
        "verificationStatus": { "enum": ["passed", "not-run", "unknown", "partial", "failed", "scan-failed"] },
        "batchId": { "$ref": "#/$defs/nonEmpty" },
        "priority": { "type": "integer", "minimum": 0 },
        "nextWorkItemRef": { "type": ["string", "null"] },
        "blocker": { "type": ["string", "null"] },
        "evidenceGap": { "type": ["string", "null"] },
        "splitReason": { "type": ["string", "null"] },
        "mergeGroupId": { "type": ["string", "null"] },
        "mergeReason": { "type": ["string", "null"] },
        "deriveReason": { "type": ["string", "null"] },
        "compatibilityReason": { "type": ["string", "null"] },
        "exclusionReason": { "type": ["string", "null"] },
        "approvalRefs": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "reentryCondition": { "type": ["string", "null"] },
        "legacyRetention": { "enum": ["compatibility-only", "unused-but-retained", "active-legacy-authority", "none"] },
        "identityReview": { "type": ["string", "null"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappingId", "targetRef", "relation", "role", "mappingContract", "evidenceRefs", "verificationRefs"],
      "properties": {
        "mappingId": { "$ref": "#/$defs/nonEmpty" },
        "targetRef": { "$ref": "#/$defs/targetRef" },
        "relation": { "enum": ["move", "split", "merge", "derive", "compatibility", "excluded", "deferred"] },
        "role": { "enum": ["authoritative", "reader", "query-consumer", "command-issuer", "adapter", "projection", "value-object", "integration", "none"] },
        "mappingContract": { "$ref": "#/$defs/mappingContract" },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "verificationRefs": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "targetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetMemberId"],
      "properties": {
        "kind": { "enum": ["component-member", "query", "adapter", "projection", "value-object", "none"] },
        "targetMemberId": { "type": ["string", "null"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "mappingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sourceType",
        "targetType",
        "conversion",
        "unit",
        "nullability",
        "defaultSemantics",
        "rangeSemantics",
        "normalization",
        "lossiness",
        "reversible",
        "invariants",
        "authorityTransfer",
        "dualWritePolicy"
      ],
      "properties": {
        "kind": { "$ref": "#/$defs/nonEmpty" },
        "sourceType": { "$ref": "#/$defs/nonEmpty" },
        "targetType": { "$ref": "#/$defs/nonEmpty" },
        "conversion": { "$ref": "#/$defs/nonEmpty" },
        "unit": { "$ref": "#/$defs/nonEmpty" },
        "nullability": { "$ref": "#/$defs/nonEmpty" },
        "defaultSemantics": { "$ref": "#/$defs/nonEmpty" },
        "rangeSemantics": { "$ref": "#/$defs/nonEmpty" },
        "normalization": { "$ref": "#/$defs/nonEmpty" },
        "lossiness": { "$ref": "#/$defs/nonEmpty" },
        "reversible": { "type": "boolean" },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "authorityTransfer": { "$ref": "#/$defs/nonEmpty" },
        "dualWritePolicy": { "$ref": "#/$defs/nonEmpty" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "targetMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetMemberId", "componentPath", "componentType", "member", "signature", "kind", "authorityRole", "origin", "designReason"],
      "properties": {
        "targetMemberId": { "type": "string", "pattern": "^[^:/\\\\]+::[^:/\\\\]+::[^:/\\\\]+::[^:/\\\\]+$" },
        "projectOrAssembly": { "$ref": "#/$defs/nonEmpty" },
        "componentPath": { "$ref": "#/$defs/nonEmpty" },
        "componentType": { "$ref": "#/$defs/nonEmpty" },
        "member": { "$ref": "#/$defs/nonEmpty" },
        "signature": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["field", "property"] },
        "authorityRole": { "enum": ["authoritative", "reader", "query-consumer", "command-issuer", "adapter", "projection", "value-object", "integration", "none"] },
        "origin": { "enum": ["migrated", "new", "derived", "integration", "compatibility"] },
        "designReason": { "type": ["string", "null"] },
        "authorityOwner": { "type": ["string", "null"] },
        "structuralWriteRoot": { "type": ["string", "null"] },
        "authorityScope": { "type": ["string", "null"] },
        "lifecycle": { "type": ["string", "null"] },
        "persistencePolicy": { "type": ["string", "null"] },
        "networkPolicy": { "type": ["string", "null"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "path", "claim", "status"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["declaration", "reader", "writer", "authority", "lifecycle", "persistence", "network", "reflection", "serialization", "generated-code", "dynamic", "delegate", "native-adapter", "helper-indirect", "behavior", "scope", "review"] },
        "path": { "$ref": "#/$defs/nonEmpty" },
        "line": { "type": "integer", "minimum": 1 },
        "symbol": { "type": ["string", "null"] },
        "claim": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["confirmed", "not-applicable", "open", "partial", "unknown", "stale"] },
        "owner": { "type": ["string", "null"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verificationId", "kind", "verificationSpec", "passed", "exitCode", "ledgerFactSha256", "sourceSnapshotSha256", "targetSnapshotSha256"],
      "properties": {
        "verificationId": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "const": "command" },
        "verificationSpec": { "$ref": "#/$defs/verificationSpec" },
        "passed": { "type": "boolean" },
        "exitCode": { "type": "integer" },
        "ledgerFactSha256": { "$ref": "#/$defs/sha256" },
        "sourceSnapshotSha256": { "$ref": "#/$defs/sha256" },
        "targetSnapshotSha256": { "$ref": "#/$defs/sha256" },
        "recordedAt": { "type": ["string", "null"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "verificationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments", "workingDirectory", "expectedExitCode"],
      "properties": {
        "tool": { "$ref": "#/$defs/nonEmpty" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "workingDirectory": { "$ref": "#/$defs/nonEmpty" },
        "expectedExitCode": { "type": "integer" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItemId",
        "kind",
        "title",
        "status",
        "priority",
        "sourceMemberRefs",
        "targetMappingRefs",
        "prerequisites",
        "requiredEvidenceRefs",
        "allowedChangeScope",
        "allowedFiles",
        "forbiddenDomains",
        "completionCriteria",
        "verificationSpec",
        "expectedArtifacts",
        "blocker",
        "checkpoint",
        "claim"
      ],
      "properties": {
        "workItemId": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["member-evidence", "identity-review", "merge-review", "split-review", "scope-review", "verification-review", "manifest-review"] },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["ready", "in-progress", "blocked", "deferred", "done", "abandoned"] },
        "priority": { "type": "integer", "minimum": 0 },
        "sourceMemberRefs": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "behaviorRefs": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "targetMappingRefs": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "targetMemberRefs": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "requiredEvidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "allowedChangeScope": { "$ref": "#/$defs/nonEmpty" },
        "allowedFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "forbiddenDomains": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "completionCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "verificationSpec": { "$ref": "#/$defs/verificationSpec" },
        "expectedArtifacts": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "blocker": { "type": ["string", "null"] },
        "checkpoint": { "$ref": "#/$defs/nonEmpty" },
        "claim": { "$ref": "#/$defs/claim" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "claim": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["owner", "claimedAt", "checkpoint", "leaseStatus"],
      "properties": {
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "claimedAt": { "$ref": "#/$defs/nonEmpty" },
        "checkpoint": { "$ref": "#/$defs/nonEmpty" },
        "leaseStatus": { "enum": ["active", "released", "abandoned", "takeover-approved"] },
        "previousOwner": { "type": ["string", "null"] },
        "takeoverReason": { "type": ["string", "null"] },
        "previousLedgerFactSha256": { "type": ["string", "null"] }
      }
    },
    "changeLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "revision", "actor", "action", "entityId"],
      "properties": {
        "eventId": { "$ref": "#/$defs/nonEmpty" },
        "revision": { "type": "integer", "minimum": 1 },
        "actor": { "$ref": "#/$defs/nonEmpty" },
        "action": { "$ref": "#/$defs/nonEmpty" },
        "entityId": { "$ref": "#/$defs/nonEmpty" },
        "recordedAt": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "generatedView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewId", "kind", "path", "sha256", "generatedFromLedgerFactSha256"],
      "properties": {
        "viewId": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["markdown-quick-reference", "machine-quick-reference", "target-index", "context-packet"] },
        "path": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "generatedFromLedgerFactSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "version", "consumer", "values"],
      "properties": {
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "consumer": { "$ref": "#/$defs/nonEmpty" },
        "values": { "type": "object" }
      }
    }
  }
}
