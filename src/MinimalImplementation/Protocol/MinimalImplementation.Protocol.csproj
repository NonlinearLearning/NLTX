<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MinimalImplementation.Protocol</AssemblyName>
    <RootNamespace>MinimalImplementation.Server.Protocol</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\MinimalImplementation.Contracts.csproj" />
    <ProjectReference Include="..\..\NSSLC.Infrastructure\Network\Pocket\DataPacketDefinition\PacketDesignCompiler.Packets.csproj" />
    <ProjectReference Include="..\..\NSSLC.Infrastructure\Network\Pocket\PacketDesignCompiler.Core.csproj" />
    <ProjectReference Include="..\Tools\WireCompiler\MinimalImplementation.WireCompiler.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="PacketFrameAssembler.cs" />
    <Compile Include="PacketFrameCodec.cs" />
    <Compile Include="PacketFrameFormatException.cs" />
    <Compile Include="PacketTcpConnection.cs" />
    <Compile Include="PacketTcpConnectionOptions.cs" />
    <Compile Include="TcpListenerAdapter.cs" />
    <Compile Include="TcpListenerAdapterOptions.cs" />
    <Compile Include="Version4ModuleCodecs.cs" />
    <Compile Include="Version4ModulePayloads.cs" />
    <Compile Include="Version4ProtocolFactsFactory.cs" />
    <Compile Include="Version4ProtocolFactsInput.cs" />
    <Compile Include="Version4EncodedPacket.cs" />
    <Compile Include="Version4PacketFormatException.cs" />
    <Compile Include="Version4WireProfile.cs" />
    <Compile Include="RawPacketFrame.cs" />
    <Compile Include="InboundRawFrame.cs" />
    <Compile Include="InboundVersion4Packet.cs" />
    <Compile Include="ConnectionByteBudget.cs" />
    <Compile Include="Version4PacketConnection.cs" />
    <Compile Include="Version4ReservedPacketPolicy.cs" />
    <Compile Include="DebugCommandHandler.cs" />
  </ItemGroup>

  <Target Name="GenerateVersion4WireCode" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <Version4GeneratedDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\Build\generated\MinimalImplementation.Protocol\$(Configuration)\$(TargetFramework)'))</Version4GeneratedDirectory>
      <Version4WireCompiler>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\Build\bin\MinimalImplementation.WireCompiler\$(Configuration)\net10.0\MinimalImplementation.WireCompiler.dll'))</Version4WireCompiler>
      <RepositoryRootDirectory>$(MSBuildProjectDirectory)\..\..\..</RepositoryRootDirectory>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(Version4WireCompiler)&quot; --repository-root &quot;$(RepositoryRootDirectory)&quot; --output-directory &quot;$(Version4GeneratedDirectory)&quot;" />
    <ItemGroup>
      <Compile Include="$(Version4GeneratedDirectory)\*.g.cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
