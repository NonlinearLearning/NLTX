<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Arch" Version="2.1.0" />
    <PackageReference Include="Arch.System" Version="1.1.0" />
    <Compile Include="Chat/**/*.cs" />
    <Compile Include="Npc/**/*.cs" />
    <Compile Include="Player/**/*.cs" />
    <Compile Include="Projectile/**/*.cs" />
    <Compile Include="Share/AI/**/*.cs" />
    <Compile Include="Share/Attributes/**/*.cs" />
    <Compile Include="Share/Combat/**/*.cs" />
    <Compile Include="Share/Emission/**/*.cs" />
    <Compile Include="Share/Entity/**/*.cs" />
    <Compile Include="Share/Inventory/**/*.cs" />
    <Compile Include="Share/Item/**/*.cs" />
    <Compile Include="Share/Physics/**/*.cs" />
    <Compile Include="World/**/*.cs" />
    <Compile Include="WorldItem/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- P1 影子装配对照需要同时调用 Build 与 BuildLegacy（两者都是 internal）。 -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Terraria.Projectile</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
