<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NetWorkRoot Condition="'$(NetWorkRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..\ProjectItem\SourceCode\Net\NetWork\</NetWorkRoot>
    <NetworkGeneratedDirectory>$(RepositoryBuildRoot)generated\Network</NetworkGeneratedDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NetCoreServer" Version="8.0.7" />
    <ProjectReference Include="..\..\NSSLC.Application\NSSLC.Application.csproj" />
    <ProjectReference Include="..\..\NSSLC\Component\Projectile\Terraria.Projectile.csproj" />
    <ProjectReference Include="$(NetWorkRoot)src\Packets\PacketDesignCompiler.Packets.csproj" />
    <ProjectReference Include="..\..\..\Build\Tools\NetworkCodecGenerator\NetworkCodecGenerator.csproj"
                      ReferenceOutputAssembly="false" />
    <Compile Include="*.cs" />
  </ItemGroup>
  <Target Name="GenerateNetworkCodecs" BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <NetworkGenerator>$(RepositoryBuildRoot)bin\NetworkCodecGenerator\$(Configuration)\net10.0\NetworkCodecGenerator.dll</NetworkGenerator>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(NetworkGenerator)&quot; &quot;$(NetworkGeneratedDirectory)&quot;" />
    <ItemGroup>
      <Compile Include="$(NetworkGeneratedDirectory)\*.g.cs" />
    </ItemGroup>
  </Target>
</Project>
