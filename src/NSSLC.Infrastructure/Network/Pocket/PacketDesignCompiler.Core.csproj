<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NetWork.PacketDesignCompiler</AssemblyName>
    <RootNamespace>Terraria.NetWork.Prototype.PacketDesignCompiler</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <ProjectReference Include="Generator/PacketDesignCompiler.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include="CompilerMethodCatalog.cs" />
    <Compile Include="CompilerMemberCatalog.cs" />
    <Compile Include="Model.cs" />
    <Compile Include="DependencyModel.cs" />
    <Compile Include="TypedNodes.cs" />
    <Compile Include="FunctionDeclarations.cs" />
    <Compile Include="FunctionDeclarationCompiler.cs" />
    <Compile Include="ExternalDependencyCompiler.cs" />
    <Compile Include="PacketReadResult.cs" />
    <Compile Include="PacketGraph.cs" />
    <Compile Include="WireFormats.cs" />
    <Compile Include="PacketComposition.cs" />
    <Compile Include="ProtocolDefinition.cs" />
    <Compile Include="DefinitionHost.cs" />
    <Compile Include="PacketDesignCompiler.cs" />
    <Compile Include="CompilerCore.cs" />
    <Compile Include="CompositionCompiler.cs" />
    <Compile Include="FrameBudgetCompiler.cs" />
    <Compile Include="CSharpBackend.cs" />
    <Compile Include="FormatBackend.cs" />
    <Compile Include="ProtocolBackend.cs" />
    <Compile Include="WireTransport.cs" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NetWork.PacketDesignCompiler.Verification</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
